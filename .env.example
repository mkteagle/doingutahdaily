# Database
DATABASE_URL="postgresql://user:password@host.proxy.rlwy.net:PORT/railway"

# Public API URL
NEXT_PUBLIC_API_URL="https://doingutahdaily.com"

# Admin server only. Generate a long-lived Instagram Login token for @doingutahdaily.
# The feed uses instagram_business_basic. Dashboard-generated tokens last 60 days.
INSTAGRAM_GRAPH_TOKEN=

# Google Calendar
GOOGLE_CLIENT_EMAIL="your_google_client_email"
GOOGLE_PRIVATE_KEY="your_google_private_key"
GOOGLE_CALENDAR_ID="your_calendar_id"

# Unsplash
UNSPLASH_ACCESS_KEY="your_unsplash_key"

# Local content worker
CONTENT_WORKER_URL="http://127.0.0.1:4010"
CONTENT_WORKER_SECRET="your_content_worker_shared_secret"

# TaskJunky bridge
TASKJUNKY_API_BASE_URL="https://taskjunky.app"
TASKJUNKY_API_TOKEN="your_taskjunky_api_token"
TASKJUNKY_WORKER_ID="mac-mini-content-worker"
TASKJUNKY_POLL_INTERVAL_MS="5000"
TASKJUNKY_CLAIM_PATH="/api/worker-jobs/claim"
TASKJUNKY_COMPLETE_PATH="/api/worker-jobs/:jobId/complete"
TASKJUNKY_FAIL_PATH="/api/worker-jobs/:jobId/fail"
TASKJUNKY_TASKS_PATH="/api/tasks"

# Post asset storage (Cloudflare R2)
POST_ASSETS_R2_ACCESS_KEY_ID="your_r2_access_key_id"
POST_ASSETS_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
POST_ASSETS_R2_BUCKET_NAME="your_posts_bucket_name"
POST_ASSETS_R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
POST_ASSETS_R2_PUBLIC_URL="https://cdn.doingutahdaily.com"

# AI drafting used by the local content worker
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-5-mini"

# Scheduled publishing and Instagram sync
CRON_SECRET="your_cron_secret"

# Auth.js / Next.js auth
# Apply packages/db/migrations/002_admin_better_auth.sql to the admin database before deploying.
# Existing AUTH_SECRET and AUTH_URL values also work.
BETTER_AUTH_SECRET="generate_a_long_random_secret"
BETTER_AUTH_URL=

# Google OAuth
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Apple OAuth
# APPLE_SERVICE_ID / APPLE_CLIENT_ID should usually be your Apple Services ID (web)
# APPLE_CLIENT_SECRET is the generated Apple client secret JWT
APPLE_SERVICE_ID="your_apple_services_id"
APPLE_CLIENT_ID="your_apple_services_id"
APPLE_CLIENT_SECRET="your_generated_apple_client_secret"
APPLE_TEAM_ID="your_apple_team_id"
APPLE_KEY_ID="your_apple_key_id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional blog sponsorship and hosted reader support URLs (HTTPS)
BLOG_SPONSOR_NAME=
BLOG_SPONSOR_URL=
READER_SUPPORT_URL=

# Admin passkeys use the admin HTTPS origin (or http://localhost for development).
AUTH_PASSKEYS_ENABLED=false

# Optional server-side bearer token for the ChatGPT story workspace.
# Set a random token of at least 32 characters and supply it to the MCP client.
DUD_MCP_DRAFT_TOKEN=

# Use a revocable Kindred share for a curated editorial album.
# The share link and password are server secrets.
KINDRED_EDITORIAL_ALBUM_URL=
KINDRED_EDITORIAL_ALBUM_PASSWORD=
